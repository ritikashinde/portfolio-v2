+"use client";
+
+import { useEffect, useRef } from "react";
+
+export default function DissolveCanvas() {
+  const ref = useRef<HTMLCanvasElement>(null);
+
+  useEffect(() => {
+    const canvas = ref.current;
+    if (!canvas) return;
+    const ctx = canvas.getContext("2d");
+    if (!ctx) return;
+
+    const W = 280;
+    const H = 280;
+    canvas.width = W;
+    canvas.height = H;
+
+    const N = 90;
+    const particles = Array.from({ length: N }, (_, i) => {
+      const gx = (i % 9) * (W / 9) + 14;
+      const gy = Math.floor(i / 9) * (H / 10) + 14;
+      return {
+        x: Math.random() * W,
+        y: Math.random() * H,
+        tx: gx,
+        ty: gy,
+        r: Math.random() * 1.6 + 0.6,
+      };
+    });
+
+    let t = 0;
+    let frame: number;
+    const prefersReduced = window.matchMedia(
+      "(prefers-reduced-motion: reduce)"
+    ).matches;
+
+    function draw() {
+      if (!ctx) return;
+      t += prefersReduced ? 0 : 0.006;
+      ctx.clearRect(0, 0, W, H);
+      const settle = (Math.sin(t) + 1) / 2;
+      particles.forEach((p) => {
+        const x = p.x + (p.tx - p.x) * settle;
+        const y = p.y + (p.ty - p.y) * settle;
+        ctx.beginPath();
+        ctx.arc(x, y, p.r, 0, Math.PI * 2);
+        ctx.fillStyle =
+          settle > 0.6 ? "rgba(124,74,45,0.55)" : "rgba(22,19,15,0.3)";
+        ctx.fill();
+      });
+      frame = requestAnimationFrame(draw);
+    }
+    draw();
+
+    return () => cancelAnimationFrame(frame);
+  }, []);
+
+  return (
+    <canvas
+      ref={ref}
+      className="w-[280px] h-[280px]"
+      aria-hidden="true"
+    />
+  );
+}
